# Copy this file to .env. Never commit .env.

# --- Needed in Phase 1 ---
NODE_ENV=development
PORT=3001
# Leave empty to use the embedded Postgres in ./pgdata (no setup needed).
# To use Neon or any Postgres server, paste its connection string here.
DATABASE_URL=
PGLITE_DIR=./pgdata
LOG_LEVEL=info

# --- Needed from Phase 2 (leave empty for now) ---
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_DAILY_LIMIT=20

# The address the browser uses. In development that is the Vite dev server, which forwards
# /api calls to this server. Requests that change data from any other site are refused.
APP_ORIGIN=http://localhost:5173

# --- Needed in Phase 5 ---
AI_MONTHLY_BUDGET_USD=20

# Estimates only. Set these to the current prices for your AI_MODEL_FAST.
AI_FAST_INPUT_USD_PER_MILLION=1
AI_FAST_OUTPUT_USD_PER_MILLION=5
